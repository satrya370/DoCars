# Application Settings
APP_NAME="Tresna Krisna"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_DOMAIN=mytourbali.com

DB_CONNECTION=mysql
DB_HOST=mysql                 # Nama service di docker-compose.yml
DB_PORT=3306
DB_DATABASE=travel_db        # Sesuai dengan MYSQL_DATABASE di docker-compose.yml
DB_USERNAME=travel_user      # Sesuai dengan MYSQL_USER di docker-compose.yml  
DB_PASSWORD=travel_password  # Sesuai dengan MYSQL_PASSWORD di docker-compose.yml
